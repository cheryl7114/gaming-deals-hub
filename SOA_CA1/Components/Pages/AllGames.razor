@page "/games"
@using SOA_CA1.ApiClients
@using SOA_CA1.Models
@inject RawgApiClient Rawg

<PageTitle>All Games | GameHub</PageTitle>

<main class="home-page">
    <section class="home-games" aria-labelledby="games-heading">
        <div class="home-section-heading">
            <div>
                <p class="home-section-kicker">DISCOVER</p>
                <h1 id="games-heading" class="text-3xl font-extrabold tracking-tight text-white">All Games</h1>
                <p class="home-section-description">Browse all games in the catalogue.</p>
            </div>
            @if (games.Count > 0)
            {
                <span class="home-results-count">Page @currentPage</span>
            }
        </div>

        @if (error is not null)
        {
            <div class="home-message home-error" role="alert">
                <span class="home-message-icon" aria-hidden="true">!</span>
                <div>
                    <strong>We couldn’t load the games</strong>
                    <p>@error</p>
                </div>
            </div>
        }
        else if (isLoading)
        {
            <div class="home-message home-loading" role="status">
                <span class="home-spinner" aria-hidden="true"></span>
                <span>Loading games...</span>
            </div>
        }
        else if (games.Count == 0)
        {
            <div class="home-empty">
                <span aria-hidden="true">⌕</span>
                <h2>No games to show</h2>
                <p>There are no games available on this page.</p>
            </div>
        }
        else
        {
            <div class="home-game-grid">
                @foreach (var game in games)
                {
                    <a class="home-game-card group" href="@($"/games/{game.RawgId}")" aria-label="@($"View details for {game.Name}")">
                        <div class="home-game-art">
                            @if (game.ArtworkUrl is not null)
                            {
                                <img src="@game.ArtworkUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <div class="home-art-placeholder" aria-hidden="true">GAMEHUB</div>
                            }
                        </div>
                        <div class="home-game-info">
                            <h2>@game.Name</h2>
                            <div class="home-game-meta">
                                <span class="home-rating">
                                    <span aria-hidden="true">★</span>
                                    @(game.Rating?.ToString("0.0") ?? "N/A")
                                </span>
                                <span>@(game.ReleaseDate?.ToString("yyyy") ?? "Release date unknown")</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }

        @if (!isLoading && error is null && games.Count > 0)
        {
            <nav class="home-pagination" aria-label="Catalogue pages">
                <button type="button"
                        @onclick="() => LoadPageAsync(currentPage - 1)"
                        disabled="@(currentPage <= 1)">
                    Previous
                </button>
                <span>Page @currentPage</span>
                <button type="button"
                        @onclick="() => LoadPageAsync(currentPage + 1)"
                        disabled="@(!hasNextPage)">
                    Next
                </button>
            </nav>
        }
    </section>
</main>

@code {
    private List<Game> games = [];
    private int currentPage = 1;
    private bool hasNextPage;
    private bool isLoading;
    private string? error;

    protected override Task OnInitializedAsync() => LoadPageAsync(currentPage);

    private async Task LoadPageAsync(int page)
    {
        if (page <= 0 || isLoading)
        {
            return;
        }

        isLoading = true;
        error = null;

        try
        {
            var result = await Rawg.GetCatalogueGamesAsync(page);
            games = result.Games.ToList();
            currentPage = page;
            hasNextPage = result.HasNextPage;
        }
        catch (HttpRequestException ex)
        {
            error = $"RAWG request failed: {ex.Message}";
        }
        catch (System.Text.Json.JsonException ex)
        {
            error = $"RAWG returned an invalid JSON response: {ex.Message}";
        }
        catch (InvalidDataException ex)
        {
            error = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
