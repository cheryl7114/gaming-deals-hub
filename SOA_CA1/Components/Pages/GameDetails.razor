@page "/games/{RawgId:int}"
@using SOA_CA1.ApiClients
@using SOA_CA1.Models
@inject RawgApiClient Rawg
@inject CheapSharkApiClient CheapShark
@inject FrankfurterApiClient Frankfurter

<PageTitle>@(game?.Name ?? "Game details")</PageTitle>

@if (isLoading)
{
    <main class="game-details-page game-details-loading">
        <p>Loading game details...</p>
    </main>
}
else if (error is not null)
{
    <main class="game-details-page game-details-error">
        <a class="game-back-link" href="/">← Back to search</a>
        <p role="alert">@error</p>
    </main>
}
else if (game is not null)
{
    <main class="game-details-page">
        <a class="game-back-link" href="/">← Back to search</a>

        @if (Photos.Count > 0)
        {
            <section aria-label="Game images" class="game-gallery">
                <div class="game-gallery-heading">
                    <h2>Screenshots & artwork</h2>
                    <span>Select an image to view it</span>
                </div>
                <div class="game-gallery-track">
                    @for (var index = 0; index < Photos.Count; index++)
                    {
                        var photoIndex = index;
                        <button class="game-gallery-item"
                                type="button"
                                aria-label="@($"View image {photoIndex + 1} of {Photos.Count} for {game.Name}")"
                                @onclick="() => OpenPhoto(photoIndex)">
                            <img class="game-gallery-image"
                                 src="@Photos[photoIndex]"
                                 alt="@($"{game.Name} image {photoIndex + 1}")"
                                 loading="lazy" />
                            <span class="game-gallery-overlay"></span>
                        </button>
                    }
                </div>
            </section>
        }

        <section class="game-content-grid">
            <div class="game-content">
                <p class="game-eyebrow">Game details</p>
                <h1 class="game-title">@game.Name</h1>

                <div class="game-meta game-meta-mobile md:hidden">
                    <div class="game-meta-card">
                        <p class="game-meta-label">Released</p>
                        <p class="game-meta-value">@(game.ReleaseDate?.ToString("d MMM yyyy") ?? "Unknown")</p>
                    </div>
                    <div class="game-meta-card">
                        <p class="game-meta-label">Rating</p>
                        <p class="game-meta-value"><span>⭐</span> @(game.Rating?.ToString() ?? "Not rated")</p>                    </div>
                </div>

                <div class="game-panel">
                    <h2 class="game-panel-title">About this game</h2>
                    <p class="game-description">@(string.IsNullOrWhiteSpace(game.Description)
                        ? "Description not available."
                        : game.Description)</p>
                </div>

                <div class="game-panel game-developers">
                    <h2 class="game-panel-title">Developers</h2>
                    @if (game.Developers.Count > 0)
                    {
                        <p class="game-description">@string.Join(", ", game.Developers)</p>
                    }
                    else
                    {
                        <p class="game-muted">Developer information not available.</p>
                    }
                </div>

                <section class="game-panel game-developers" aria-labelledby="deals-heading">
                    <h2 id="deals-heading" class="game-panel-title">Compare prices</h2>

                    @if (dealsLoading)
                    {
                        <p class="game-muted">Loading available offers...</p>
                    }
                    else if (dealsError is not null)
                    {
                        <p role="alert">@dealsError</p>
                    }
                    else if (deals.Count == 0)
                    {
                        <p class="game-muted">No offers are currently available.</p>
                    }
                    else
                    {
                        <ul class="deal-offer-list">
                            @foreach (var deal in deals)
                            {
                                <li class="deal-offer">
                                    <div class="deal-store">
                                        <p class="deal-store-name">@deal.StoreName</p>
                                        <p class="deal-normal-price">
                                            Regular price: @FormatEuroPrice(deal.NormalPriceUsd)                                        </p>
                                    </div>
                                    <div class="deal-offer-actions">
                                        <p class="deal-sale-price">
                                            @FormatEuroPrice(deal.SalePriceUsd)
                                        </p>
                                        @if (deal.DealUrl is not null)
                                        {
                                            <a href="@deal.DealUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="deal-link">
                                                View deal
                                            </a>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <aside class="game-sidebar">
                @if (game.ArtworkUrl is not null)
                {
                    <button class="game-artwork-button"
                            type="button"
                            aria-label="View main artwork"
                            @onclick="() => OpenPhoto(0)">
                        <img class="game-artwork-image"
                             src="@game.ArtworkUrl"
                             alt="@($"{game.Name} artwork")" />
                    </button>
                }

                <div class="game-meta game-meta-sidebar hidden md:flex">
                    <div class="game-meta-card">
                        <p class="game-meta-label">Released</p>
                        <p class="game-meta-value">@(game.ReleaseDate?.ToString("d MMM yyyy") ?? "Unknown")</p>
                    </div>
                    <div class="game-meta-card">
                        <p class="game-meta-label">Rating</p>
                        <p class="game-meta-value">@(game.Rating?.ToString() ?? "Not rated")</p>
                    </div>
                </div>
            </aside>
        </section>
    </main>

    // photo display lightbox
    @if (selectedPhotoIndex is int selectedIndex)
    {
        <div class="game-lightbox"
             role="presentation"
             @onclick="ClosePhoto">
            <section class="game-lightbox-content"
                     role="dialog"
                     aria-modal="true"
                     aria-label="@($"{game.Name} image viewer")"
                     @onclick:stopPropagation="true">
                <button class="game-lightbox-nav"
                        type="button"
                        aria-label="Previous image"
                        disabled="@(Photos.Count < 2)"
                        @onclick="ShowPreviousPhoto">‹</button>

                <img class="game-lightbox-image"
                     src="@Photos[selectedIndex]"
                     alt="@($"{game.Name} image {selectedIndex + 1} of {Photos.Count}")" />

                <button class="game-lightbox-nav"
                        type="button"
                        aria-label="Next image"
                        disabled="@(Photos.Count < 2)"
                        @onclick="ShowNextPhoto">›</button>

                <button class="game-lightbox-close"
                        type="button"
                        aria-label="Close image viewer"
                        @onclick="ClosePhoto">×</button>
            </section>
        </div>
    }
}

@code {
    [Parameter]
    public int RawgId { get; set; }

    private Game? game;
    private bool isLoading;
    private string? error;
    private int? selectedPhotoIndex;
    private List<Deal> deals = [];
    private bool dealsLoading;
    private string? dealsError;
    private ExchangeRate? usdToEurRate;

    // The main artwork is the first item, followed by RAWG's extra screenshots.
    private List<string> Photos => game is null
        ? []
        : (new[] { game.ArtworkUrl })
            .OfType<string>()
            .Concat(game.Screenshots)
            .Distinct()
            .ToList();

    private void OpenPhoto(int index) => selectedPhotoIndex = index;

    private void ClosePhoto() => selectedPhotoIndex = null;

    private void ShowPreviousPhoto()
    {
        if (Photos.Count > 1 && selectedPhotoIndex is int index)
        {
            selectedPhotoIndex = (index - 1 + Photos.Count) % Photos.Count;
        }
    }

    private void ShowNextPhoto()
    {
        if (Photos.Count > 1 && selectedPhotoIndex is int index)
        {
            selectedPhotoIndex = (index + 1) % Photos.Count;
        }
    }
    
    private string FormatEuroPrice(decimal priceUsd)
    {
        var priceEur = usdToEurRate!.Convert(priceUsd);
        return "€" + priceEur.ToString(
            "0.00",
            System.Globalization.CultureInfo.InvariantCulture);
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        error = null;
        game = null;
        deals = [];
        dealsLoading = false;
        dealsError = null;

        try
        {
            game = await Rawg.GetFullDetailsAsync(RawgId);
        }
        catch (HttpRequestException ex)
        {
            error = $"RAWG request failed: {ex.Message}";
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (InvalidDataException ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }

        if (game is not null)
        {
            dealsLoading = true;
            await InvokeAsync(StateHasChanged);

            try
            {
                deals = (await CheapShark.GetDealsForGameAsync(game.Name)).ToList();
                if (deals.Count > 0)
                {
                    usdToEurRate = await Frankfurter.GetUsdToEurRateAsync();
                }
            }
            catch (HttpRequestException ex)
            {
                dealsError = $"Price or exchange-rate request failed: {ex.Message}";
            }
            catch (InvalidDataException ex)
            {
                dealsError = ex.Message;
            }
            catch (System.Text.Json.JsonException ex)
            {
                dealsError = $"Exchange-rate response was invalid: {ex.Message}";
            }
            finally
            {
                dealsLoading = false;
            }
        }
    }
}